FROM docker.io/library/debian:12

ARG ARCH=x86_64
ARG MOLD_VERSION=3.0.0
ARG MOLD_SHA256=6c90d4a474c7c0409dfb575be03a5345878ac14fdba18de8b40fa58c60121189
ARG APPIMAGETOOL_VERSION=1.9.1
ARG APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
ARG RUNTIME_VERSION=20251108
ARG RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

RUN apt-get -o APT::Sandbox::User=root update \
	&& DEBIAN_FRONTEND=noninteractive apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
		ca-certificates curl git file patchelf \
		clang-19 cmake ninja-build ccache pkg-config \
		libssl-dev \
		libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev \
		libxss-dev libxtst-dev libxinerama-dev \
		libwayland-dev wayland-protocols libxkbcommon-dev libdecor-0-dev \
		libegl-dev libgl-dev libgles-dev libdrm-dev libgbm-dev \
		libasound2-dev libpulse-dev libpipewire-0.3-dev \
		libudev-dev libdbus-1-dev libibus-1.0-dev \
	&& rm -rf /var/lib/apt/lists/* \
	&& ln -s /usr/bin/clang-19 /usr/local/bin/clang \
	&& ln -s /usr/bin/clang++-19 /usr/local/bin/clang++

RUN cd /tmp \
	&& curl -fsSL -o mold.tar.gz \
		"https://github.com/rui314/mold/releases/download/v${MOLD_VERSION}/mold-${MOLD_VERSION}-${ARCH}-linux.tar.gz" \
	&& echo "${MOLD_SHA256}  mold.tar.gz" | sha256sum -c - \
	&& tar -xzf mold.tar.gz --strip-components=1 -C /usr/local \
	&& rm mold.tar.gz

RUN cd /opt \
	&& curl -fsSL -o appimagetool.AppImage \
		"https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VERSION}/appimagetool-${ARCH}.AppImage" \
	&& echo "${APPIMAGETOOL_SHA256}  appimagetool.AppImage" | sha256sum -c - \
	&& chmod +x appimagetool.AppImage \
	&& ./appimagetool.AppImage --appimage-extract > /dev/null \
	&& mv squashfs-root appimagetool \
	&& rm appimagetool.AppImage \
	&& ln -s /opt/appimagetool/AppRun /usr/local/bin/appimagetool \
	&& curl -fsSL -o appimage-runtime \
		"https://github.com/AppImage/type2-runtime/releases/download/${RUNTIME_VERSION}/runtime-${ARCH}" \
	&& echo "${RUNTIME_SHA256}  appimage-runtime" | sha256sum -c -

ENV APPIMAGETOOL_RUNTIME_FILE=/opt/appimage-runtime
ENV BGAME_SDK=appimage
