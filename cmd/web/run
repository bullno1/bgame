#!/bin/sh -e

# Serves the web build on localhost and opens it in the browser.
#
# The page cannot spawn a process, so opening a picked element in the editor
# goes through this server: the page sends `POST /__open-in-editor?file=&line=`
# and the server runs the BGAME_EDITOR template on this machine, with the rules
# the native build uses (whitespace splits, double quotes group, `{file}` and
# `{line}` are replaced). Only a file under the project root is opened, and
# only for a request from the page itself: the Host header must be this
# server's, and a cross-site request (Origin or Sec-Fetch-Site says so) is
# refused, so no other page in the browser can reach the editor.
#
#   cmd/web/run [--port N] [--no-browser]

CMD_DIR=$(dirname "$0")
RELOADABLE=OFF
. "${CMD_DIR}/../common.sh"

DIR="bin/web/${BUILD_DIR}"
if [ ! -f "${DIR}/${APP}.html" ]
then
	echo "${DIR}/${APP}.html not found: build first" >&2
	exit 1
fi

# exec, so the server is this process and a signal to it is a signal to the server
ROOT="${ROOT}" DIR="${DIR}" APP="${APP}" exec python3 - "$@" <<'PY'
import os, subprocess, sys, webbrowser
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

root = os.path.realpath(os.environ["ROOT"])
directory = os.path.join(root, os.environ["DIR"])
page = os.environ["APP"] + ".html"
host = "127.0.0.1"
port = 6931
browser = True

args = sys.argv[1:]
while args:
	arg = args.pop(0)
	if arg == "--port" and args:
		port = int(args.pop(0))
	elif arg == "--no-browser":
		browser = False
	else:
		sys.exit(f"Unknown argument: {arg}")

EDITOR_ENV = "BGAME_EDITOR"
ENDPOINT = "/__open-in-editor"

def split_command(text, file, line):
	args = []
	i = 0
	while i < len(text):
		while i < len(text) and text[i] in " \t\r\n":
			i += 1
		if i >= len(text):
			break
		if text[i] == '"':
			start = i + 1
			end = text.find('"', start)
			if end < 0:
				end = len(text)
			i = end + 1
		else:
			start = i
			while i < len(text) and text[i] not in " \t\r\n":
				i += 1
			end = i
		args.append(text[start:end].replace("{file}", file).replace("{line}", line))
	return args

class Handler(SimpleHTTPRequestHandler):
	def __init__(self, *args, **kwargs):
		super().__init__(*args, directory=directory, **kwargs)

	def guess_type(self, path):
		if path.endswith(".wasm"):
			return "application/wasm"
		return super().guess_type(path)

	def end_headers(self):
		self.send_header("Cache-Control", "no-store")
		super().end_headers()

	def log_message(self, format, *args):
		if "favicon.ico" not in self.path:
			super().log_message(format, *args)

	def do_GET(self):
		if urlsplit(self.path).path == "/":
			self.send_response(HTTPStatus.FOUND)
			self.send_header("Location", "/" + page)
			self.end_headers()
			return
		super().do_GET()

	def do_POST(self):
		parts = urlsplit(self.path)
		if parts.path != ENDPOINT:
			self.send_error(HTTPStatus.NOT_FOUND)
			return
		status, message = self.open_in_editor(parse_qs(parts.query))
		body = (message + "\n").encode()
		self.send_response(status)
		self.send_header("Content-Type", "text/plain; charset=utf-8")
		self.send_header("Content-Length", str(len(body)))
		self.end_headers()
		self.wfile.write(body)

	def is_same_origin(self):
		own = f"{host}:{port}"
		if self.headers.get("Host") not in (own, f"localhost:{port}"):
			return False
		origin = self.headers.get("Origin")
		if origin is not None and origin != "http://" + self.headers.get("Host"):
			return False
		site = self.headers.get("Sec-Fetch-Site")
		return site is None or site == "same-origin"

	def open_in_editor(self, query):
		if not self.is_same_origin():
			return HTTPStatus.FORBIDDEN, "Not from the page"
		template = os.environ.get(EDITOR_ENV)
		if not template:
			return HTTPStatus.NOT_IMPLEMENTED, f"{EDITOR_ENV} is not set"
		file = query.get("file", [""])[0]
		line = query.get("line", [""])[0]
		if not file or not line.isdigit():
			return HTTPStatus.BAD_REQUEST, "file and line are required"
		path = os.path.realpath(file)
		if not path.startswith(root + os.sep):
			return HTTPStatus.FORBIDDEN, f"{file} is outside the project"
		if not os.path.isfile(path):
			return HTTPStatus.NOT_FOUND, f"{file} does not exist"
		argv = split_command(template, path, line)
		if not argv:
			return HTTPStatus.NOT_IMPLEMENTED, f"{EDITOR_ENV} is empty"
		try:
			subprocess.Popen(
				argv,
				stdin=subprocess.DEVNULL,
				stdout=subprocess.DEVNULL,
				stderr=subprocess.DEVNULL,
				start_new_session=True,
			)
		except OSError as error:
			return HTTPStatus.INTERNAL_SERVER_ERROR, f"Could not run {argv[0]}: {error}"
		print(f"Opened {os.path.relpath(path, root)}:{line}", flush=True)
		return HTTPStatus.OK, "Opened"

server = ThreadingHTTPServer((host, port), Handler)
url = f"http://{host}:{port}/{page}"
print(f"Serving {directory} at {url}", flush=True)
if not os.environ.get(EDITOR_ENV):
	print(f"{EDITOR_ENV} is not set: picking an element will only log its location", flush=True)
if browser:
	webbrowser.open(url)
try:
	server.serve_forever()
except KeyboardInterrupt:
	pass
PY
