# commands
# --------------------------------------------------------------------------


DEFAULT_CONFIG = """\
[kudo]
# Everything kudo owns lives under one directory, so the tool leaves exactly
# two things in your project root: this file and CREDITS.md.

# Downloaded packs, one directory per pack, never edited.
vendor = "kudo/vendor"

# Append-only record of which vendor files are in use.
manifest = "kudo/manifest.jsonl"

# Original zips, kept for provenance. Gitignore these if they get large;
# they are compressed duplicates of what is already in vendor/.
archive = "kudo/archive"

# Directories kudo manages in YOUR project. Files here that are not manifest
# destinations are reported as unaccounted. This is where assets actually
# ship from, so it stays outside kudo/.
roots = ["assets"]

# "copy" (safe everywhere) or "symlink" (no duplication, needs Developer Mode
# on Windows and -h/-L flags when packaging).
mode = "copy"

credits_output = "CREDITS.md"

# Globs for your own work, so the linter stops asking about it. Matched
# against project-relative paths with forward slashes; note that * crosses
# directory boundaries.
first_party = []
"""

SOURCE_TEMPLATE = """\
name = {name}
author = {author}
url = {url}
license = {license}          # SPDX identifier, or LicenseRef-custom
acquired = {acquired}
version = {version}
{extra}\
# attribution = "Kenney (kenney.nl)"   # if the author asks for exact wording
# keep = true                          # hold an unused pack without nagging
"""


def toml_str(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def cmd_init(args) -> int:
    root = Path.cwd()
    path = root / CONFIG_NAME
    if path.exists():
        raise KudoError(f"{CONFIG_NAME} already exists")

    probe = Config(root=root)
    home = root / Path(probe.vendor).parts[0]
    if home.exists() and not home.is_dir():
        raise KudoError(
            f"'{home.name}' exists and is not a directory — probably the kudo "
            f"script itself. Move it onto your PATH, or set vendor/manifest/"
            f"archive to different paths in {CONFIG_NAME}."
        )

    path.write_text(DEFAULT_CONFIG, encoding="utf-8")
    cfg = load_config()
    cfg.vendor_dir.mkdir(parents=True, exist_ok=True)
    cfg.archive_dir.mkdir(parents=True, exist_ok=True)
    cfg.manifest_path.parent.mkdir(parents=True, exist_ok=True)
    cfg.manifest_path.touch()
    for r in cfg.roots:
        (cfg.root / r).mkdir(parents=True, exist_ok=True)

    print(f"initialized kudo in {root}")
    print(f"  {CONFIG_NAME}")
    print(f"  {cfg.vendor}/       downloaded packs, never edited")
    print(f"  {cfg.archive}/      original zips")
    print(f"  {cfg.manifest}   what you actually use")
    print(f"  {'/, '.join(cfg.roots)}/             where assets land")
    return EXIT_OK


def cmd_import(args) -> int:
    cfg = load_config()
    src = Path(args.path)
    if not src.exists():
        raise KudoError(f"{src} does not exist")
    name = args.name or src.stem
    dest = cfg.vendor_dir / name
    if dest.exists():
        raise KudoError(f"vendor pack '{name}' already exists")

    dest.mkdir(parents=True)
    archived = ""
    archived_hash = ""
    if src.is_dir():
        shutil.copytree(src, dest, dirs_exist_ok=True)
    else:
        extract_pack(src, dest)
        if not args.no_archive:
            cfg.archive_dir.mkdir(parents=True, exist_ok=True)
            target = cfg.archive_dir / src.name
            shutil.copy2(src, target)
            archived = src.name
            archived_hash = hash_file(target)

    extra = ""
    if archived:
        extra = (f"archive = {toml_str(archived)}\n"
                 f"archive_hash = {toml_str(archived_hash)}\n")
        if args.archive_url:
            extra += f"archive_url = {toml_str(args.archive_url)}\n"
        else:
            extra += ("# archive_url = \"https://...\"   # direct zip link, for "
                      "'kudo fetch'\n")

    (dest / SOURCE_NAME).write_text(SOURCE_TEMPLATE.format(
        name=toml_str(args.title or name),
        author=toml_str(args.author or "FIXME"),
        url=toml_str(args.url or "FIXME"),
        license=toml_str(args.license or "FIXME"),
        acquired=toml_str(date.today().isoformat()),
        version=toml_str(args.pack_version or ""),
        extra=extra,
    ), encoding="utf-8")

    count = len(pack_files(load_pack(cfg, name)))
    print(f"imported {count} files into {cfg.vendor}/{name}/")
    if archived:
        print(f"archived original to {cfg.archive}/{archived}")
    if not (args.author and args.url and args.license):
        print(f"\nFill in {cfg.vendor}/{name}/{SOURCE_NAME} now, while you still")
        print("have the download page open. Add the LICENSE file if the zip lacked one.")
    return EXIT_OK


def cmd_add(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)

    # Accept either a vendor-relative path or a real path (so tab-completion works).
    source = None
    if not Path(args.source).is_absolute() and (cfg.vendor_dir / args.source).is_file():
        source = args.source
    elif Path(args.source).is_file():
        resolved = Path(os.path.abspath(str(Path(args.source))))
        try:
            source = str(resolved.relative_to(os.path.abspath(str(cfg.vendor_dir))))
        except ValueError:
            raise KudoError(
                f"{args.source} is not inside {cfg.vendor}/. Third-party files must "
                f"be imported first: kudo import <zip> <name>"
            ) from None
    if source is None:
        raise KudoError(f"no such vendor file: {cfg.vendor}/{args.source}")
    source = source.replace(os.sep, "/")

    abs_src = cfg.vendor_dir / source
    if load_pack(cfg, source.split("/", 1)[0]) is None:
        raise KudoError(f"'{source}' is not inside a vendor pack directory")

    dest = rel_to_root(cfg, Path(args.dest))
    if dest.startswith(".."):
        raise KudoError(f"destination must be inside the project, got {args.dest}")
    if dest == cfg.vendor or dest.startswith(cfg.vendor + "/"):
        raise KudoError(f"destination cannot be inside {cfg.vendor}/; that would "
                        "overwrite the pristine copy")
    if any(e.dest == dest for e in entries):
        raise KudoError(f"{dest} is already in the manifest")
    if not any(dest == r or dest.startswith(r.rstrip("/") + "/") for r in cfg.roots):
        print(f"warning: {dest} is outside the managed roots {cfg.roots};"
              " the linter will not audit it", file=sys.stderr)

    entry = Entry(
        source=source,
        dest=dest,
        source_hash=hash_file(abs_src),
        modified=args.modified,
        note=args.note or "",
        added=date.today().isoformat(),
    )

    if args.modified:
        target = cfg.root / dest
        if not target.exists():
            raise KudoError(
                f"{dest} does not exist. For a modified asset, put your version "
                "in place first; kudo records it, it does not create it."
            )
        entry.dest_hash = hash_file(target)
    else:
        materialize(cfg, entry)

    append_entry(cfg, entry)
    verb = "recorded" if args.modified else ("linked" if cfg.mode == "symlink" else "copied")
    print(f"{verb} {dest}  <-  {cfg.vendor}/{source}")
    if args.modified and not entry.note:
        print("note: no --note given; CC BY requires indicating that changes were made")
    return EXIT_OK


def cmd_sync(args) -> int:
    cfg = load_config()
    return do_sync(cfg, load_manifest(cfg))


def do_sync(cfg: Config, entries: list[Entry]) -> int:
    created = restored = skipped = 0
    problems = 0
    for e in entries:
        src = cfg.vendor_dir / e.source
        dst = cfg.root / e.dest
        if e.modified:
            if not dst.exists():
                print(f"error: {e.dest} is modified and missing; restore it from "
                      "version control", file=sys.stderr)
                problems += 1
            continue
        if not src.is_file():
            print(f"error: missing vendor source {cfg.vendor}/{e.source}", file=sys.stderr)
            problems += 1
            continue
        existed = dst.exists() or dst.is_symlink()
        if existed and not dst.is_symlink() and hash_file(dst) == e.source_hash:
            set_readonly(dst)
            skipped += 1
            continue
        materialize(cfg, e)
        if existed:
            restored += 1
        else:
            created += 1
    print(f"sync: {created} created, {restored} restored, {skipped} unchanged, "
          f"{sum(1 for e in entries if e.modified)} modified (left alone)")
    return EXIT_DRIFT if problems else EXIT_OK


def cmd_check(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    issues, stats = run_checks(cfg, entries, deep=args.archives)

    fixed: list[str] = []
    if args.fix:
        fixed = apply_fixes(cfg, entries, issues)
        if fixed:
            issues, stats = run_checks(cfg, entries, deep=args.archives)

    errors = [i for i in issues if i.level == "error"]
    warns = [i for i in issues if i.level == "warn"]

    if args.json:
        print(json.dumps({
            "ok": not errors,
            "fixed": fixed,
            "issues": [asdict(i) for i in issues],
            "packs": [asdict(s) for s in stats],
            "totals": {
                "entries": len(entries),
                "modified": sum(1 for e in entries if e.modified),
                "packs": len(stats),
                "errors": len(errors),
                "warnings": len(warns),
            },
        }, indent=2))
        return EXIT_DRIFT if errors else EXIT_OK

    for line in fixed:
        print(f"  fixed  {line}")
    if errors:
        print(f"\n{len(errors)} error(s):")
        print_issues(errors)
    if warns:
        print(f"\n{len(warns)} warning(s):")
        print_issues(warns)
    if args.stats:
        print(f"\npacks:")
        print_stats(stats)
    if not errors and not warns:
        print(f"clean: {len(entries)} entries across {len(stats)} packs")
    elif not errors:
        print(f"\nno errors ({len(entries)} entries, {len(stats)} packs)")
    return EXIT_DRIFT if errors else EXIT_OK


def cmd_stats(args) -> int:
    """A presentation of the same computation check runs. Always exits 0."""
    cfg = load_config()
    entries = load_manifest(cfg)
    issues, stats = run_checks(cfg, entries)
    print_stats(stats)
    used = sum(s.used for s in stats)
    total = sum(s.total for s in stats)
    derived = sum(s.entries for s in stats)
    unused = [s.name for s in stats if s.used == 0 and not s.keep]
    tail = f" producing {derived} assets" if derived != used else ""
    print(f"\n{used} of {total} vendored files in use across {len(stats)} packs"
          f"{tail}  ({sum(1 for e in entries if e.modified)} modified)")
    if unused:
        print(f"unused: {', '.join(unused)}")
    errs = sum(1 for i in issues if i.level == "error")
    if errs:
        print(f"\n{errs} error(s) — run 'kudo check' for detail")
    return EXIT_OK


def _find(entries: list[Entry], dest: str, cfg: Config) -> Entry:
    norm = rel_to_root(cfg, Path(dest))
    for e in entries:
        if e.dest in (dest, norm):
            return e
    raise KudoError(f"{dest} is not in the manifest")


def cmd_bless(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    entry = _find(entries, args.dest, cfg)
    if not entry.modified:
        raise KudoError(f"{entry.dest} is not marked modified; use 'kudo edit' first")
    target = cfg.root / entry.dest
    if not target.is_file():
        raise KudoError(f"{entry.dest} does not exist")
    entry.dest_hash = hash_file(target)
    if args.upstream:
        src = cfg.vendor_dir / entry.source
        if not src.is_file():
            raise KudoError(f"vendor source {entry.source} is missing")
        entry.source_hash = hash_file(src)
    if args.note:
        entry.note = args.note
    rewrite_manifest(cfg, entries)
    print(f"blessed {entry.dest}")
    if args.upstream:
        print(f"  and accepted the current {cfg.vendor}/{entry.source} as its basis")
    return EXIT_OK


def cmd_edit(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    entry = _find(entries, args.dest, cfg)
    target = cfg.root / entry.dest
    if entry.modified:
        set_writable(target)
        print(f"{entry.dest} is already marked modified; unlocked")
        return EXIT_OK
    if target.is_symlink():
        real = target.resolve()
        target.unlink()
        shutil.copy2(real, target)
        print(f"replaced symlink with a real copy (edits would have written into "
              f"{cfg.vendor}/)")
    entry.modified = True
    entry.note = args.note or entry.note
    if target.exists():
        set_writable(target)
        entry.dest_hash = hash_file(target)
    rewrite_manifest(cfg, entries)
    print(f"{entry.dest} is now writable and marked modified")
    if not entry.note:
        print("add a note with 'kudo bless --note' once you are done")
    return EXIT_OK


def cmd_rm(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    entry = _find(entries, args.dest, cfg)
    if entry.modified and not args.force:
        raise KudoError(
            f"{entry.dest} is a modified asset; deleting it loses your work. "
            "Pass --force if you mean it."
        )
    if not args.keep_file:
        unlink_dest(cfg, entry)
    entries.remove(entry)
    rewrite_manifest(cfg, entries)
    remaining = sum(1 for e in entries if e.pack == entry.pack)
    print(f"removed {entry.dest}")
    if remaining == 0:
        print(f"{cfg.vendor}/{entry.pack} now has no files in use; "
              f"delete it or set keep = true in its {SOURCE_NAME}")
    return EXIT_OK



def cmd_fetch(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    packs = all_packs(cfg)
    if args.packs:
        by_name = {p.name: p for p in packs}
        unknown = [n for n in args.packs if n not in by_name]
        if unknown:
            raise KudoError(f"no such vendor pack(s): {', '.join(unknown)}")
        packs = [by_name[n] for n in args.packs]

    fetched: list[Pack] = []
    manual: list[Pack] = []
    problems = 0

    for pack in packs:
        arc, arc_hash = archive_for(cfg, pack)
        url = pack.meta.get("archive_url")

        if arc is not None and arc.is_file() and not args.force:
            continue  # already have it

        if not url:
            manual.append(pack)
            continue

        name = str(pack.meta.get("archive") or Path(urllib.parse.urlparse(url).path).name)
        if not name:
            print(f"error: {pack.name}: cannot derive a filename from {url}",
                  file=sys.stderr)
            problems += 1
            continue
        target = cfg.archive_dir / name

        print(f"fetching {pack.name} <- {url}")
        try:
            size = download(str(url), target, timeout=args.timeout)
        except KudoError as exc:
            print(f"error: {pack.name}: {exc}", file=sys.stderr)
            problems += 1
            continue

        actual = hash_file(target)
        if arc_hash and actual != arc_hash:
            target.unlink()
            print(f"error: {pack.name}: downloaded file does not match the hash in "
                  f"{SOURCE_NAME}; discarded", file=sys.stderr)
            problems += 1
            continue
        if not arc_hash:
            print(f"  warning: no archive_hash recorded; nothing verified this "
                  f"download. Add archive_hash = {toml_str(actual)}")
        print(f"  {human_bytes(size)} -> {cfg.archive}/{name}")
        fetched.append(pack)

    for pack in manual:
        page = pack.meta.get("url", "(no url recorded)")
        print(f"{pack.name}: no archive_url. Download it from {page} and put the "
              f"zip in {cfg.archive}/", file=sys.stderr)

    if args.restore:
        for pack in fetched:
            print()
            rc = cmd_restore(argparse.Namespace(
                pack=pack.name, force=False, dry_run=False, no_sync=True))
            if rc != EXIT_OK:
                problems += 1
        if fetched:
            print()
            do_sync(cfg, load_manifest(cfg))

    if not fetched and not manual and not problems:
        print("nothing to fetch; every archive is already present")
    return EXIT_DRIFT if problems else EXIT_OK


def cmd_restore(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    pack = load_pack(cfg, args.pack)
    if pack is None:
        raise KudoError(f"no such vendor pack: {args.pack}")

    arc, arc_hash = archive_for(cfg, pack)
    if arc is None:
        raise KudoError(
            f"{args.pack} has no 'archive' in its {SOURCE_NAME}; there is "
            "nothing to restore from. Re-download and 'kudo import' it."
        )
    if not arc.is_file():
        raise KudoError(f"archived zip is missing: {rel_to_root(cfg, arc)}")
    if arc_hash:
        actual = hash_file(arc)
        if actual != arc_hash and not args.force:
            raise KudoError(
                f"{rel_to_root(cfg, arc)} does not match the hash recorded at "
                "import. Restoring from it would replace your pristine copy "
                "with unknown content. Pass --force if you trust this zip."
            )

    used = [e for e in entries if e.pack == args.pack]
    before = {}
    for e in used:
        src = cfg.vendor_dir / e.source
        before[e.source] = hash_file(src) if src.is_file() else None

    if args.dry_run:
        print(f"would re-extract {rel_to_root(cfg, arc)} over "
              f"{cfg.vendor}/{args.pack}/ ({len(used)} entries depend on it)")
        return EXIT_OK

    # SOURCE.toml is ours, not the zip's. Everything else is replaced.
    source_toml = (pack.dir / SOURCE_NAME).read_bytes() if (pack.dir / SOURCE_NAME).is_file() else None
    shutil.rmtree(pack.dir)
    pack.dir.mkdir(parents=True)
    extract_pack(arc, pack.dir)
    if source_toml is not None:
        (pack.dir / SOURCE_NAME).write_bytes(source_toml)

    print(f"restored {cfg.vendor}/{args.pack}/ from {rel_to_root(cfg, arc)}")

    # Report per source file, not per entry: one tileset can back many slices.
    by_source: dict[str, list[Entry]] = {}
    for e in used:
        by_source.setdefault(e.source, []).append(e)

    repaired = gone = still = 0
    for source, deps in sorted(by_source.items()):
        expected = deps[0].source_hash
        suffix = f" ({len(deps)} derived)" if len(deps) > 1 else ""
        src = cfg.vendor_dir / source
        if not src.is_file():
            print(f"  gone      {source} (not in the archive){suffix}")
            gone += 1
        elif hash_file(src) == expected:
            if before[source] != expected:
                print(f"  repaired  {source}{suffix}")
                repaired += 1
        else:
            print(f"  differs   {source} (archive does not match the recorded "
                  f"hash){suffix}")
            still += 1
    if by_source:
        print(f"{repaired} repaired, {still} still differing, {gone} missing, "
              f"of {len(by_source)} vendor file(s) in use")
    if not args.no_sync:
        print()
        return do_sync(cfg, entries)
    return EXIT_DRIFT if (still or gone) else EXIT_OK


def render_markdown(cfg: Config, groups: list[tuple[Pack, list[Entry]]]) -> str:
    out = ["# Credits", ""]
    out.append("Third-party assets used in this project, with thanks.")
    out.append("")
    for pack, used in groups:
        m = pack.meta
        out.append(f"## {m.get('name', pack.name)}")
        out.append("")
        out.append(pack.credit_line())
        bits = []
        if m.get("url"):
            bits.append(f"Source: <{m['url']}>")
        if m.get("license"):
            bits.append(f"License: {m['license']}")
        if bits:
            out.append("")
            out.append("  \n".join(bits))
        mods = [e for e in used if e.modified]
        if mods:
            out.append("")
            out.append("Modified for this project:")
            out.append("")
            for e in mods:
                note = f" — {e.note}" if e.note else " — modified"
                out.append(f"- `{e.dest}`{note}")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def render_text(cfg: Config, groups: list[tuple[Pack, list[Entry]]]) -> str:
    out = ["CREDITS", ""]
    for pack, used in groups:
        m = pack.meta
        line = pack.credit_line()
        if m.get("license"):
            line += f" ({m['license']})"
        out.append(line)
        if m.get("url"):
            out.append(f"  {m['url']}")
        for e in (x for x in used if x.modified):
            out.append(f"  modified: {e.note or e.dest}")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def render_json(cfg: Config, groups: list[tuple[Pack, list[Entry]]]) -> str:
    payload = []
    for pack, used in groups:
        m = pack.meta
        payload.append({
            "pack": pack.name,
            "title": m.get("name", pack.name),
            "author": m.get("author"),
            "url": m.get("url"),
            "license": m.get("license"),
            "attribution": pack.credit_line(),
            "files": [
                {"path": e.dest, "modified": e.modified, "note": e.note or None}
                for e in used
            ],
        })
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def cmd_credits(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    if not args.force:
        issues, _ = run_checks(cfg, entries)
        errors = [i for i in issues if i.level == "error"]
        if errors:
            print(f"refusing to generate credits: {len(errors)} error(s) from "
                  "'kudo check'. Credits built on a broken manifest are worse "
                  "than no credits. Pass --force to override.", file=sys.stderr)
            return EXIT_DRIFT

    by_pack: dict[str, list[Entry]] = {}
    for e in entries:
        by_pack.setdefault(e.pack, []).append(e)

    groups: list[tuple[Pack, list[Entry]]] = []
    for name in sorted(by_pack):
        pack = load_pack(cfg, name)
        if pack is None:
            print(f"warning: skipping missing pack '{name}'", file=sys.stderr)
            continue
        groups.append((pack, by_pack[name]))

    render = {"md": render_markdown, "txt": render_text, "json": render_json}[args.format]
    text = render(cfg, groups)

    if args.output == "-":
        sys.stdout.write(text)
    else:
        out = cfg.root / (args.output or cfg.credits_output)
        out.write_text(text, encoding="utf-8")
        print(f"wrote {rel_to_root(cfg, out)}  ({len(groups)} packs, {len(entries)} files)")
    return EXIT_OK


