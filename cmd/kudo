#!/usr/bin/env python3
"""kudo - track attribution for third-party assets in game projects.

A vendor directory holds packs exactly as downloaded. A manifest records which
files you actually use and where they land. A linter verifies the filesystem
still matches what the manifest claims. Credits are generated, never written
by hand.

Requires Python 3.11+ (stdlib only).
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import shutil
import stat
import sys
import tomllib
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from dataclasses import dataclass, field, asdict
from datetime import date
from pathlib import Path

VERSION = "0.1.0"

EXIT_OK = 0
EXIT_DRIFT = 1
EXIT_USAGE = 2

CONFIG_NAME = "kudo.toml"
SOURCE_NAME = "SOURCE.toml"
LICENSE_NAMES = ("LICENSE", "LICENSE.txt", "LICENSE.md", "COPYING", "LICENCE")


class KudoError(Exception):
    """User-facing error. Exits with EXIT_USAGE."""


# --------------------------------------------------------------------------
# config
# --------------------------------------------------------------------------


@dataclass
class Config:
    root: Path
    vendor: str = "kudo/vendor"
    manifest: str = "kudo/manifest.jsonl"
    archive: str = "kudo/archive"
    roots: list[str] = field(default_factory=lambda: ["assets"])
    mode: str = "copy"  # "copy" | "symlink"
    credits_output: str = "CREDITS.md"
    first_party: list[str] = field(default_factory=list)

    @property
    def vendor_dir(self) -> Path:
        return self.root / self.vendor

    @property
    def manifest_path(self) -> Path:
        return self.root / self.manifest

    @property
    def archive_dir(self) -> Path:
        return self.root / self.archive


def find_config(start: Path) -> Path | None:
    for d in [start, *start.parents]:
        if (d / CONFIG_NAME).is_file():
            return d / CONFIG_NAME
    return None


def load_config() -> Config:
    path = find_config(Path.cwd())
    if path is None:
        raise KudoError(
            f"no {CONFIG_NAME} found in this directory or any parent.\n"
            "Run 'kudo init' to create one."
        )
    with path.open("rb") as fh:
        data = tomllib.load(fh)
    section = data.get("kudo", data)
    known = {f for f in Config.__dataclass_fields__ if f != "root"}
    unknown = set(section) - known
    if unknown:
        raise KudoError(f"unknown key(s) in {path}: {', '.join(sorted(unknown))}")
    cfg = Config(root=path.parent, **section)
    if cfg.mode not in ("copy", "symlink"):
        raise KudoError(f"mode must be 'copy' or 'symlink', got {cfg.mode!r}")
    return cfg


# --------------------------------------------------------------------------
# manifest
# --------------------------------------------------------------------------


@dataclass
class Entry:
    source: str  # relative to vendor dir, e.g. "kenney_platformer/tiles/block.png"
    dest: str  # relative to project root, e.g. "assets/sprites/block.png"
    source_hash: str
    modified: bool = False
    dest_hash: str = ""
    note: str = ""
    added: str = ""

    @property
    def pack(self) -> str:
        return self.source.split("/", 1)[0]

    def to_json(self) -> str:
        d = asdict(self)
        if not d["note"]:
            d.pop("note")
        if not d["dest_hash"]:
            d.pop("dest_hash")
        return json.dumps(d, ensure_ascii=False)


def load_manifest(cfg: Config) -> list[Entry]:
    path = cfg.manifest_path
    if not path.exists():
        return []
    entries: list[Entry] = []
    for lineno, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            raw = json.loads(line)
        except json.JSONDecodeError as exc:
            raise KudoError(f"{path}:{lineno}: invalid JSON: {exc}") from exc
        missing = {"source", "dest", "source_hash"} - set(raw)
        if missing:
            raise KudoError(f"{path}:{lineno}: missing field(s): {', '.join(sorted(missing))}")
        allowed = set(Entry.__dataclass_fields__)
        entries.append(Entry(**{k: v for k, v in raw.items() if k in allowed}))
    return entries


def append_entry(cfg: Config, entry: Entry) -> None:
    with cfg.manifest_path.open("a", encoding="utf-8") as fh:
        fh.write(entry.to_json() + "\n")


def rewrite_manifest(cfg: Config, entries: list[Entry]) -> None:
    tmp = cfg.manifest_path.with_suffix(".jsonl.tmp")
    tmp.write_text("".join(e.to_json() + "\n" for e in entries), encoding="utf-8")
    tmp.replace(cfg.manifest_path)


# --------------------------------------------------------------------------
# packs
# --------------------------------------------------------------------------


@dataclass
class Pack:
    name: str
    dir: Path
    meta: dict

    @property
    def has_license(self) -> bool:
        return any((self.dir / n).exists() for n in LICENSE_NAMES)

    def credit_line(self) -> str:
        if self.meta.get("attribution"):
            return str(self.meta["attribution"])
        title = self.meta.get("name", self.name)
        author = self.meta.get("author", "unknown")
        return f"{title} by {author}"


def load_pack(cfg: Config, name: str) -> Pack | None:
    d = cfg.vendor_dir / name
    if not d.is_dir():
        return None
    meta: dict = {}
    src = d / SOURCE_NAME
    if src.is_file():
        with src.open("rb") as fh:
            meta = tomllib.load(fh)
    return Pack(name=name, dir=d, meta=meta)


def all_packs(cfg: Config) -> list[Pack]:
    if not cfg.vendor_dir.is_dir():
        return []
    out = []
    for d in sorted(cfg.vendor_dir.iterdir()):
        if d.is_dir() and not d.name.startswith("."):
            p = load_pack(cfg, d.name)
            if p:
                out.append(p)
    return out


def pack_files(pack: Pack) -> list[Path]:
    """Every content file in a pack, excluding metadata."""
    skip = {SOURCE_NAME, *LICENSE_NAMES}
    out = []
    for p in pack.dir.rglob("*"):
        if p.is_file() and p.name not in skip and not any(
            part.startswith(".") for part in p.relative_to(pack.dir).parts
        ):
            out.append(p)
    return sorted(out)


# --------------------------------------------------------------------------
# filesystem helpers
# --------------------------------------------------------------------------



def download(url: str, dest: Path, timeout: int = 120) -> int:
    """Fetch url to dest atomically. Returns bytes written."""
    scheme = urllib.parse.urlparse(url).scheme
    if scheme not in ("http", "https", "file"):
        raise KudoError(f"refusing to fetch {scheme or 'schemeless'} URL: {url}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": f"kudo/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp, part.open("wb") as fh:
            shutil.copyfileobj(resp, fh)
    except urllib.error.HTTPError as exc:
        part.unlink(missing_ok=True)
        raise KudoError(f"{url} returned HTTP {exc.code}") from None
    except (urllib.error.URLError, OSError, ValueError) as exc:
        part.unlink(missing_ok=True)
        raise KudoError(f"could not fetch {url}: {exc}") from None
    size = part.stat().st_size
    part.replace(dest)
    return size


def extract_pack(zip_path: Path, dest: Path) -> None:
    """Unpack a zip into dest, collapsing the wrapping directory itch zips use.

    ZipFile.extract sanitizes member paths, so a zip cannot escape dest.
    """
    with zipfile.ZipFile(zip_path) as zf:
        zf.extractall(dest)
    junk = dest / "__MACOSX"
    if junk.is_dir():
        shutil.rmtree(junk)
    kids = list(dest.iterdir())
    if len(kids) == 1 and kids[0].is_dir():
        inner = kids[0]
        for child in list(inner.iterdir()):
            shutil.move(str(child), str(dest / child.name))
        inner.rmdir()


def archive_for(cfg: Config, pack: Pack) -> tuple[Path | None, str]:
    """The pack's archived zip and its recorded hash, if it declared one."""
    name = pack.meta.get("archive")
    if not name:
        return None, ""
    return cfg.archive_dir / str(name), str(pack.meta.get("archive_hash", ""))


def hash_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()


def set_readonly(path: Path) -> None:
    if path.is_symlink():
        return  # chmod would follow the link into vendor/
    mode = path.stat().st_mode
    path.chmod(mode & ~(stat.S_IWUSR | stat.S_IWGRP | stat.S_IWOTH))


def set_writable(path: Path) -> None:
    if path.is_symlink():
        return
    mode = path.stat().st_mode
    path.chmod(mode | stat.S_IWUSR)


def is_readonly(path: Path) -> bool:
    return not (path.stat().st_mode & stat.S_IWUSR)


def materialize(cfg: Config, entry: Entry) -> None:
    """Create the destination for an unmodified entry."""
    src = cfg.vendor_dir / entry.source
    dst = cfg.root / entry.dest
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.exists() or dst.is_symlink():
        set_writable(dst) if dst.exists() and not dst.is_symlink() else None
        dst.unlink()
    if cfg.mode == "symlink":
        rel = os.path.relpath(src, dst.parent)
        dst.symlink_to(rel)
        set_readonly(src)  # protect vendor from writes through the link
    else:
        shutil.copy2(src, dst)
        set_readonly(dst)


def unlink_dest(cfg: Config, entry: Entry) -> None:
    dst = cfg.root / entry.dest
    if dst.is_symlink():
        dst.unlink()
    elif dst.exists():
        set_writable(dst)
        dst.unlink()


def rel_to_root(cfg: Config, path: Path) -> str:
    """Project-relative path, normalized lexically.

    Deliberately not Path.resolve(): that follows symlinks, so a destination
    that is already a managed link would resolve into vendor/ and we would
    overwrite the original.
    """
    absolute = os.path.abspath(os.path.join(os.getcwd(), str(path)))
    root = os.path.abspath(str(cfg.root))
    return os.path.relpath(absolute, root).replace(os.sep, "/")


# --------------------------------------------------------------------------
# checking
# --------------------------------------------------------------------------


@dataclass
class Issue:
    level: str  # "error" | "warn"
    code: str
    path: str
    message: str
    fix: str = ""  # description of what --fix would do; empty = not fixable


@dataclass
class PackStat:
    name: str
    used: int      # distinct vendor files referenced
    entries: int   # manifest rows; exceeds `used` when one file is sliced
    total: int
    modified: int
    bytes_total: int
    keep: bool
    has_source: bool
    has_license: bool


def run_checks(cfg: Config, entries: list[Entry], deep: bool = False
               ) -> tuple[list[Issue], list[PackStat]]:
    issues: list[Issue] = []
    packs = {p.name: p for p in all_packs(cfg)}
    used_by_pack: dict[str, list[Entry]] = {}
    src_hashes: dict[str, str] = {}  # one hash per vendor file, not per entry

    seen_dest: dict[str, Entry] = {}
    for e in entries:
        used_by_pack.setdefault(e.pack, []).append(e)

        if e.dest in seen_dest:
            issues.append(Issue("error", "duplicate-dest", e.dest,
                                "two manifest entries claim this destination"))
        seen_dest[e.dest] = e

        # vendor side
        if e.pack not in packs:
            issues.append(Issue("error", "orphan-pack", e.source,
                                f"vendor pack '{e.pack}' is missing"))
            continue
        src = cfg.vendor_dir / e.source
        if not src.is_file():
            issues.append(Issue("error", "missing-source", e.source,
                                "source file no longer exists in vendor"))
            continue
        if e.source in src_hashes:
            actual_src = src_hashes[e.source]
        else:
            actual_src = src_hashes[e.source] = hash_file(src)
            if actual_src != e.source_hash:
                dependents = [x.dest for x in entries if x.source == e.source]
                detail = ("; derived files needing review: "
                          + ", ".join(dependents)) if len(dependents) > 1 else ""
                issues.append(Issue("error", "upstream-changed", e.source,
                                    "vendor file differs from the recorded hash; the "
                                    "pack was updated or edited in place" + detail))

        # destination side
        dst = cfg.root / e.dest
        if not dst.exists():
            if e.modified:
                issues.append(Issue("error", "missing-derived", e.dest,
                                    "modified asset is gone and cannot be regenerated"))
            else:
                issues.append(Issue("error", "missing-dest", e.dest,
                                    "destination missing", fix="re-materialize from vendor"))
            continue

        if e.modified:
            if not e.dest_hash:
                issues.append(Issue("warn", "unblessed", e.dest,
                                    "modified entry has no recorded hash; run 'kudo bless'"))
            elif hash_file(dst) != e.dest_hash:
                issues.append(Issue("error", "derived-drift", e.dest,
                                    "modified asset changed since it was last blessed",
                                    fix="" ))
            if not e.note:
                issues.append(Issue("warn", "no-note", e.dest,
                                    "modified asset has no note; CC BY requires "
                                    "indicating that changes were made"))
        else:
            if hash_file(dst) != actual_src:
                issues.append(Issue("error", "unmanaged-edit", e.dest,
                                    "destination differs from vendor source but is not "
                                    "marked modified; run 'kudo edit' to declare it"))
            elif not dst.is_symlink() and not is_readonly(dst):
                issues.append(Issue("warn", "writable", e.dest,
                                    "managed copy is writable",
                                    fix="set read-only"))

    # unaccounted files under the managed roots
    declared = set(seen_dest)
    for root_name in cfg.roots:
        root = cfg.root / root_name
        if not root.is_dir():
            continue
        for p in root.rglob("*"):
            if not (p.is_file() or p.is_symlink()):
                continue
            rel = str(p.relative_to(cfg.root)).replace(os.sep, "/")
            if rel in declared:
                continue
            if any(fnmatch.fnmatch(rel, pat) for pat in cfg.first_party):
                continue
            issues.append(Issue("warn", "unaccounted", rel,
                                "not in the manifest and not declared first-party"))

    # pack-level metadata and usage
    stats: list[PackStat] = []
    for name, pack in sorted(packs.items()):
        files = pack_files(pack)
        used = used_by_pack.get(name, [])
        keep = bool(pack.meta.get("keep", False))
        if not pack.meta:
            issues.append(Issue("error", "no-source-toml", f"{cfg.vendor}/{name}",
                                f"pack has no {SOURCE_NAME}"))
        else:
            for required in ("author", "license"):
                if not pack.meta.get(required) and not pack.meta.get("attribution"):
                    issues.append(Issue("error", "incomplete-source", f"{cfg.vendor}/{name}",
                                        f"{SOURCE_NAME} is missing '{required}'"))
        if not pack.has_license:
            issues.append(Issue("warn", "no-license-file", f"{cfg.vendor}/{name}",
                                "pack has no LICENSE file"))

        arc, arc_hash = archive_for(cfg, pack)
        if arc is None:
            if pack.meta:
                issues.append(Issue("warn", "no-archive", f"{cfg.vendor}/{name}",
                                    "no original zip recorded; 'kudo restore' "
                                    "cannot rebuild this pack"))
        elif not arc.is_file():
            how = ("run 'kudo fetch'" if pack.meta.get("archive_url")
                   else f"no archive_url recorded, so re-download it by hand from "
                        f"{pack.meta.get('url', 'the source page')}")
            issues.append(Issue("warn", "archive-missing", rel_to_root(cfg, arc),
                                f"recorded archive is absent (gitignored?); {how}"))
        elif deep and arc_hash and hash_file(arc) != arc_hash:
            issues.append(Issue("error", "archive-corrupt", rel_to_root(cfg, arc),
                                "archive does not match the hash recorded at "
                                "import; it was replaced or has rotted"))
        if not used and not keep:
            issues.append(Issue("warn", "unused-pack", f"{cfg.vendor}/{name}",
                                "no files used; safe to delete, or set keep = true"))
        stats.append(PackStat(
            name=name,
            used=len({e.source for e in used}),
            entries=len(used),
            total=len(files),
            modified=sum(1 for e in used if e.modified),
            bytes_total=sum(f.stat().st_size for f in files),
            keep=keep,
            has_source=bool(pack.meta),
            has_license=pack.has_license,
        ))

    return issues, stats


def apply_fixes(cfg: Config, entries: list[Entry], issues: list[Issue]) -> list[str]:
    by_dest = {e.dest: e for e in entries}
    done: list[str] = []
    for issue in issues:
        if not issue.fix:
            continue
        entry = by_dest.get(issue.path)
        if entry is None:
            continue
        if issue.code == "missing-dest":
            materialize(cfg, entry)
            done.append(f"re-materialized {issue.path}")
        elif issue.code == "writable":
            set_readonly(cfg.root / entry.dest)
            done.append(f"set read-only {issue.path}")
    return done


# --------------------------------------------------------------------------
# formatting
# --------------------------------------------------------------------------


def human_bytes(n: int) -> str:
    size = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{int(size)}B" if unit == "B" else f"{size:.1f}{unit}"
        size /= 1024.0
    return f"{size:.1f}TB"


def print_issues(issues: list[Issue]) -> None:
    for issue in issues:
        marker = "error" if issue.level == "error" else "warn "
        print(f"  {marker}  {issue.path}\n         {issue.message}  [{issue.code}]")


def print_stats(stats: list[PackStat]) -> None:
    if not stats:
        print("  (no vendor packs)")
        return
    width = max(len(s.name) for s in stats)
    for s in stats:
        flags = []
        if s.keep:
            flags.append("keep")
        if not s.has_source:
            flags.append("no-source")
        if not s.has_license:
            flags.append("no-license")
        suffix = ("  (" + ", ".join(flags) + ")") if flags else ""
        mod = f", {s.modified} modified" if s.modified else ""
        if s.entries > s.used:
            mod += f", {s.entries} derived"
        usage = f"{s.used}/{s.total}"
        print(f"  {s.name.ljust(width)}  {usage:>9} files"
              f"  {human_bytes(s.bytes_total):>9}{mod}{suffix}")


