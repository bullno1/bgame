#!/usr/bin/env python3
"""kudo - track attribution for third-party assets in game projects.
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import shutil
import sys
import tomllib
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from dataclasses import dataclass, field, asdict
from datetime import date
from pathlib import Path

VERSION = "0.2.0"

EXIT_OK = 0
EXIT_DRIFT = 1
EXIT_USAGE = 2

CONFIG_NAME = "kudo.toml"
SOURCE_NAME = "SOURCE.toml"
LICENSE_NAMES = ("LICENSE", "LICENSE.txt", "LICENSE.md", "COPYING", "LICENCE")


class KudoError(Exception):
    """User-facing error. Exits with EXIT_USAGE."""


# --------------------------------------------------------------------------
# config
# --------------------------------------------------------------------------


@dataclass
class Config:
    root: Path
    vendor: str = "kudo/vendor"
    manifest: str = "kudo/manifest.jsonl"
    archive: str = "kudo/archive"
    roots: list[str] = field(default_factory=lambda: ["assets"])
    credits_output: str = "CREDITS.md"
    first_party: list[str] = field(default_factory=list)

    @property
    def vendor_dir(self) -> Path:
        return self.root / self.vendor

    @property
    def manifest_path(self) -> Path:
        return self.root / self.manifest

    @property
    def archive_dir(self) -> Path:
        return self.root / self.archive


def find_config(start: Path) -> Path | None:
    for d in [start, *start.parents]:
        if (d / CONFIG_NAME).is_file():
            return d / CONFIG_NAME
    return None


def load_config() -> Config:
    path = find_config(Path.cwd())
    if path is None:
        raise KudoError(
            f"no {CONFIG_NAME} found in this directory or any parent.\n"
            "Run 'kudo init' to create one."
        )
    with path.open("rb") as fh:
        data = tomllib.load(fh)
    section = data.get("kudo", data)
    known = {f for f in Config.__dataclass_fields__ if f != "root"}
    unknown = set(section) - known
    if unknown:
        raise KudoError(f"unknown key(s) in {path}: {', '.join(sorted(unknown))}")
    return Config(root=path.parent, **section)


# --------------------------------------------------------------------------
# manifest
# --------------------------------------------------------------------------


@dataclass
class Entry:
    dest: str  # relative to project root, e.g. "assets/sprites/block.png"
    pack: str
    note: str = ""
    added: str = ""

    def to_json(self) -> str:
        d = asdict(self)
        if not d["note"]:
            d.pop("note")
        return json.dumps(d, ensure_ascii=False)


def load_manifest(cfg: Config) -> list[Entry]:
    path = cfg.manifest_path
    if not path.exists():
        return []
    entries: list[Entry] = []
    for lineno, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            raw = json.loads(line)
        except json.JSONDecodeError as exc:
            raise KudoError(f"{path}:{lineno}: invalid JSON: {exc}") from exc
        if "pack" not in raw and "source" in raw:
            raw["pack"] = str(raw["source"]).split("/", 1)[0]
        missing = {"dest", "pack"} - set(raw)
        if missing:
            raise KudoError(f"{path}:{lineno}: missing field(s): {', '.join(sorted(missing))}")
        allowed = set(Entry.__dataclass_fields__)
        entries.append(Entry(**{k: v for k, v in raw.items() if k in allowed}))
    return entries


def rewrite_manifest(cfg: Config, entries: list[Entry]) -> None:
    tmp = cfg.manifest_path.with_suffix(".jsonl.tmp")
    tmp.write_text("".join(e.to_json() + "\n" for e in entries), encoding="utf-8")
    tmp.replace(cfg.manifest_path)


# --------------------------------------------------------------------------
# packs
# --------------------------------------------------------------------------


@dataclass
class Pack:
    name: str
    dir: Path
    meta: dict

    @property
    def has_license(self) -> bool:
        return any((self.dir / n).exists() for n in LICENSE_NAMES)

    @property
    def requires_note(self) -> bool:
        return bool(self.meta.get("require_note", False))

    def credit_line(self) -> str:
        if self.meta.get("attribution"):
            return str(self.meta["attribution"])
        title = self.meta.get("name", self.name)
        author = self.meta.get("author", "unknown")
        return f"{title} by {author}"


def load_pack(cfg: Config, name: str) -> Pack | None:
    d = cfg.vendor_dir / name
    if not d.is_dir():
        return None
    meta: dict = {}
    src = d / SOURCE_NAME
    if src.is_file():
        with src.open("rb") as fh:
            meta = tomllib.load(fh)
    return Pack(name=name, dir=d, meta=meta)


def all_packs(cfg: Config) -> list[Pack]:
    if not cfg.vendor_dir.is_dir():
        return []
    out = []
    for d in sorted(cfg.vendor_dir.iterdir()):
        if d.is_dir() and not d.name.startswith("."):
            p = load_pack(cfg, d.name)
            if p:
                out.append(p)
    return out


def resolve_pack(cfg: Config, arg: str) -> Pack:
    given = Path(os.path.abspath(arg))
    vendor = Path(os.path.abspath(str(cfg.vendor_dir)))
    name = given.name if given.parent == vendor else arg
    pack = None
    if name and Path(name).name == name and not name.startswith("."):
        pack = load_pack(cfg, name)
    if pack is None:
        names = ", ".join(p.name for p in all_packs(cfg)) or "(none)"
        raise KudoError(f"no such vendor pack: {arg}\npacks: {names}")
    return pack


def pack_files(pack: Pack) -> list[Path]:
    """Every content file in a pack, excluding metadata."""
    skip = {SOURCE_NAME, *LICENSE_NAMES}
    out = []
    for p in pack.dir.rglob("*"):
        if p.is_file() and p.name not in skip and not any(
            part.startswith(".") for part in p.relative_to(pack.dir).parts
        ):
            out.append(p)
    return sorted(out)


# --------------------------------------------------------------------------
# filesystem helpers
# --------------------------------------------------------------------------



def download(url: str, dest: Path, timeout: int = 120) -> int:
    """Fetch url to dest atomically. Returns bytes written."""
    scheme = urllib.parse.urlparse(url).scheme
    if scheme not in ("http", "https", "file"):
        raise KudoError(f"refusing to fetch {scheme or 'schemeless'} URL: {url}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": f"kudo/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp, part.open("wb") as fh:
            shutil.copyfileobj(resp, fh)
    except urllib.error.HTTPError as exc:
        part.unlink(missing_ok=True)
        raise KudoError(f"{url} returned HTTP {exc.code}") from None
    except (urllib.error.URLError, OSError, ValueError) as exc:
        part.unlink(missing_ok=True)
        raise KudoError(f"could not fetch {url}: {exc}") from None
    size = part.stat().st_size
    part.replace(dest)
    return size


def extract_pack(zip_path: Path, dest: Path) -> None:
    """Unpack a zip into dest, collapsing the wrapping directory itch zips use.

    ZipFile.extract sanitizes member paths, so a zip cannot escape dest.
    """
    with zipfile.ZipFile(zip_path) as zf:
        zf.extractall(dest)
    junk = dest / "__MACOSX"
    if junk.is_dir():
        shutil.rmtree(junk)
    kids = list(dest.iterdir())
    if len(kids) == 1 and kids[0].is_dir():
        inner = kids[0]
        for child in list(inner.iterdir()):
            shutil.move(str(child), str(dest / child.name))
        inner.rmdir()


def archive_for(cfg: Config, pack: Pack) -> tuple[Path | None, str]:
    """The pack's archived zip and its recorded hash, if it declared one."""
    name = pack.meta.get("archive")
    if not name:
        return None, ""
    return cfg.archive_dir / str(name), str(pack.meta.get("archive_hash", ""))


def hash_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()


def rel_to_root(cfg: Config, path: Path) -> str:
    """Project-relative path, normalized lexically.
    """
    absolute = os.path.abspath(os.path.join(os.getcwd(), str(path)))
    root = os.path.abspath(str(cfg.root))
    return os.path.relpath(absolute, root).replace(os.sep, "/")


def new_dest(cfg: Config, arg: str, taken: set[str]) -> str:
    dest = rel_to_root(cfg, Path(arg))
    if dest.startswith(".."):
        raise KudoError(f"destination must be inside the project, got {arg}")
    if dest == cfg.vendor or dest.startswith(cfg.vendor + "/"):
        raise KudoError(f"{dest} is inside {cfg.vendor}/; a pack's own files are "
                        "not assets of the project")
    if dest in taken:
        raise KudoError(f"{dest} is already in the manifest")
    return dest


def warn_outside_roots(cfg: Config, dest: str) -> None:
    if not any(dest == r or dest.startswith(r.rstrip("/") + "/") for r in cfg.roots):
        print(f"warning: {dest} is outside the managed roots {cfg.roots};"
              " the linter will not look for unaccounted files next to it",
              file=sys.stderr)


# --------------------------------------------------------------------------
# checking
# --------------------------------------------------------------------------


@dataclass
class Issue:
    level: str  # "error" | "warn"
    code: str
    path: str
    message: str


@dataclass
class PackStat:
    name: str
    assets: int
    files: int
    bytes_total: int
    keep: bool
    require_note: bool
    has_source: bool
    has_license: bool


def run_checks(cfg: Config, entries: list[Entry], deep: bool = False
               ) -> tuple[list[Issue], list[PackStat]]:
    issues: list[Issue] = []
    packs = {p.name: p for p in all_packs(cfg)}
    used_by_pack: dict[str, list[Entry]] = {}

    seen_dest: dict[str, Entry] = {}
    for e in entries:
        used_by_pack.setdefault(e.pack, []).append(e)

        if e.dest in seen_dest:
            issues.append(Issue("error", "duplicate-dest", e.dest,
                                "two manifest entries claim this destination"))
        seen_dest[e.dest] = e

        pack = packs.get(e.pack)
        if pack is None:
            issues.append(Issue("error", "orphan-pack", e.dest,
                                f"vendor pack '{e.pack}' is missing"))
        elif pack.requires_note and not e.note:
            issues.append(Issue("error", "no-note", e.dest,
                                f"pack '{e.pack}' sets require_note and this asset "
                                "has no note; say what was changed with "
                                "'kudo note'"))

        if not (cfg.root / e.dest).is_file():
            issues.append(Issue("error", "missing-dest", e.dest,
                                "the file is gone; restore it, follow a rename with "
                                "'kudo mv', or drop the entry with 'kudo rm'"))

    # unaccounted files under the managed roots
    declared = set(seen_dest)
    for root_name in cfg.roots:
        root = cfg.root / root_name
        if not root.is_dir():
            continue
        for p in root.rglob("*"):
            if not (p.is_file() or p.is_symlink()):
                continue
            rel = str(p.relative_to(cfg.root)).replace(os.sep, "/")
            if rel in declared:
                continue
            if any(fnmatch.fnmatch(rel, pat) for pat in cfg.first_party):
                continue
            issues.append(Issue("warn", "unaccounted", rel,
                                "not in the manifest and not declared first-party"))

    # pack-level metadata and usage
    stats: list[PackStat] = []
    for name, pack in sorted(packs.items()):
        files = pack_files(pack)
        used = used_by_pack.get(name, [])
        keep = bool(pack.meta.get("keep", False))
        if not pack.meta:
            issues.append(Issue("error", "no-source-toml", f"{cfg.vendor}/{name}",
                                f"pack has no {SOURCE_NAME}"))
        else:
            for required in ("author", "license"):
                if not pack.meta.get(required) and not pack.meta.get("attribution"):
                    issues.append(Issue("error", "incomplete-source", f"{cfg.vendor}/{name}",
                                        f"{SOURCE_NAME} is missing '{required}'"))
        if not pack.has_license:
            issues.append(Issue("warn", "no-license-file", f"{cfg.vendor}/{name}",
                                "pack has no LICENSE file"))

        arc, arc_hash = archive_for(cfg, pack)
        if arc is None:
            if pack.meta:
                issues.append(Issue("warn", "no-archive", f"{cfg.vendor}/{name}",
                                    "no original zip recorded; 'kudo restore' "
                                    "cannot rebuild this pack"))
        elif not arc.is_file():
            how = ("run 'kudo fetch'" if pack.meta.get("archive_url")
                   else f"no archive_url recorded, so re-download it by hand from "
                        f"{pack.meta.get('url', 'the source page')}")
            issues.append(Issue("warn", "archive-missing", rel_to_root(cfg, arc),
                                f"recorded archive is absent (gitignored?); {how}"))
        elif deep and arc_hash and hash_file(arc) != arc_hash:
            issues.append(Issue("error", "archive-corrupt", rel_to_root(cfg, arc),
                                "archive does not match the hash recorded at "
                                "import; it was replaced or has rotted"))
        if not used and not keep:
            issues.append(Issue("warn", "unused-pack", f"{cfg.vendor}/{name}",
                                "no assets come from it; safe to delete, or set "
                                "keep = true"))
        stats.append(PackStat(
            name=name,
            assets=len(used),
            files=len(files),
            bytes_total=sum(f.stat().st_size for f in files),
            keep=keep,
            require_note=pack.requires_note,
            has_source=bool(pack.meta),
            has_license=pack.has_license,
        ))

    return issues, stats


# --------------------------------------------------------------------------
# formatting
# --------------------------------------------------------------------------


def human_bytes(n: int) -> str:
    size = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{int(size)}B" if unit == "B" else f"{size:.1f}{unit}"
        size /= 1024.0
    return f"{size:.1f}TB"


def print_issues(issues: list[Issue]) -> None:
    for issue in issues:
        marker = "error" if issue.level == "error" else "warn "
        print(f"  {marker}  {issue.path}\n         {issue.message}  [{issue.code}]")


def print_stats(stats: list[PackStat]) -> None:
    if not stats:
        print("  (no vendor packs)")
        return
    width = max(len(s.name) for s in stats)
    for s in stats:
        flags = []
        if s.keep:
            flags.append("keep")
        if s.require_note:
            flags.append("require_note")
        if not s.has_source:
            flags.append("no-source")
        if not s.has_license:
            flags.append("no-license")
        suffix = ("  (" + ", ".join(flags) + ")") if flags else ""
        print(f"  {s.name.ljust(width)}  {s.assets:>4} assets"
              f"  {s.files:>5} files  {human_bytes(s.bytes_total):>9}{suffix}")


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------


DEFAULT_CONFIG = """\
[kudo]
# Everything kudo owns lives under one directory, so the tool leaves exactly
# two things in your project root: this file and CREDITS.md.

# Downloaded packs, one directory per pack, never edited.
vendor = "kudo/vendor"

# Which of your files come from which pack, one line per file.
manifest = "kudo/manifest.jsonl"

# Original zips, kept for provenance. Gitignore these if they get large;
# they are compressed duplicates of what is already in vendor/.
archive = "kudo/archive"

# Directories kudo audits in YOUR project. Files here that are not in the
# manifest are reported as unaccounted. This is where assets actually ship
# from, so it stays outside kudo/.
roots = ["assets"]

credits_output = "CREDITS.md"

# Globs for your own work, so the linter stops asking about it. Matched
# against project-relative paths with forward slashes; note that * crosses
# directory boundaries.
first_party = []
"""

SOURCE_TEMPLATE = """\
name = {name}
author = {author}
url = {url}
license = {license}          # SPDX identifier, or LicenseRef-custom
acquired = {acquired}
version = {version}
{extra}\
{require_note}
# attribution = "Kenney (kenney.nl)"   # if the author asks for exact wording
# keep = true                          # hold an unused pack without nagging
"""

REQUIRE_NOTE_ON = (
    "require_note = true                   # every asset from this pack says what was changed"
)
REQUIRE_NOTE_OFF = (
    "# require_note = true                 # when the license asks to indicate changes (CC BY)"
)


def toml_str(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def license_requires_note(license_id: str) -> bool:
    return license_id.upper().replace(" ", "-").startswith("CC-BY")


def cmd_init(args) -> int:
    root = Path.cwd()
    path = root / CONFIG_NAME
    if path.exists():
        raise KudoError(f"{CONFIG_NAME} already exists")

    probe = Config(root=root)
    home = root / Path(probe.vendor).parts[0]
    if home.exists() and not home.is_dir():
        raise KudoError(
            f"'{home.name}' exists and is not a directory — probably the kudo "
            f"script itself. Move it onto your PATH, or set vendor/manifest/"
            f"archive to different paths in {CONFIG_NAME}."
        )

    path.write_text(DEFAULT_CONFIG, encoding="utf-8")
    cfg = load_config()
    cfg.vendor_dir.mkdir(parents=True, exist_ok=True)
    cfg.archive_dir.mkdir(parents=True, exist_ok=True)
    cfg.manifest_path.parent.mkdir(parents=True, exist_ok=True)
    cfg.manifest_path.touch()
    for r in cfg.roots:
        (cfg.root / r).mkdir(parents=True, exist_ok=True)

    print(f"initialized kudo in {root}")
    print(f"  {CONFIG_NAME}")
    print(f"  {cfg.vendor}/       downloaded packs, never edited")
    print(f"  {cfg.archive}/      original zips")
    print(f"  {cfg.manifest}   which of your files come from which pack")
    print(f"  {'/, '.join(cfg.roots)}/             where your assets live")
    return EXIT_OK


def cmd_import(args) -> int:
    cfg = load_config()
    src = Path(args.path)
    if not src.exists():
        raise KudoError(f"{src} does not exist")
    name = args.name or src.stem
    dest = cfg.vendor_dir / name
    if dest.exists():
        raise KudoError(f"vendor pack '{name}' already exists")

    dest.mkdir(parents=True)
    archived = ""
    archived_hash = ""
    if src.is_dir():
        shutil.copytree(src, dest, dirs_exist_ok=True)
    else:
        extract_pack(src, dest)
        if not args.no_archive:
            cfg.archive_dir.mkdir(parents=True, exist_ok=True)
            target = cfg.archive_dir / src.name
            shutil.copy2(src, target)
            archived = src.name
            archived_hash = hash_file(target)

    extra = ""
    if archived:
        extra = (f"archive = {toml_str(archived)}\n"
                 f"archive_hash = {toml_str(archived_hash)}\n")
        if args.archive_url:
            extra += f"archive_url = {toml_str(args.archive_url)}\n"
        else:
            extra += ("# archive_url = \"https://...\"   # direct zip link, for "
                      "'kudo fetch'\n")

    require_note = license_requires_note(args.license or "")
    (dest / SOURCE_NAME).write_text(SOURCE_TEMPLATE.format(
        name=toml_str(args.title or name),
        author=toml_str(args.author or "FIXME"),
        url=toml_str(args.url or "FIXME"),
        license=toml_str(args.license or "FIXME"),
        acquired=toml_str(date.today().isoformat()),
        version=toml_str(args.pack_version or ""),
        extra=extra,
        require_note=REQUIRE_NOTE_ON if require_note else REQUIRE_NOTE_OFF,
    ), encoding="utf-8")

    count = len(pack_files(load_pack(cfg, name)))
    print(f"imported {count} files into {cfg.vendor}/{name}/")
    if archived:
        print(f"archived original to {cfg.archive}/{archived}")
    if require_note:
        print(f"{args.license} asks to indicate changes: require_note = true, so "
              "every asset from this pack needs a --note")
    if not (args.author and args.url and args.license):
        print(f"\nFill in {cfg.vendor}/{name}/{SOURCE_NAME} now, while you still")
        print("have the download page open. Add the LICENSE file if the zip lacked one.")
    return EXIT_OK


def cmd_add(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    pack = resolve_pack(cfg, args.pack)
    note = args.note or ""
    if pack.requires_note and not note:
        raise KudoError(
            f"pack '{pack.name}' sets require_note in its {SOURCE_NAME}; say "
            "what was changed with --note"
        )

    taken = {e.dest for e in entries}
    today = date.today().isoformat()
    added: list[Entry] = []
    for arg in args.dest:
        dest = new_dest(cfg, arg, taken)
        if not (cfg.root / dest).is_file():
            raise KudoError(
                f"{dest} does not exist. Put the file in place first; kudo "
                "records it, it does not create it."
            )
        taken.add(dest)
        added.append(Entry(dest=dest, pack=pack.name, note=note, added=today))

    rewrite_manifest(cfg, entries + added)
    for e in added:
        warn_outside_roots(cfg, e.dest)
        print(f"recorded {e.dest}  <-  {pack.name}")
    return EXIT_OK


def cmd_check(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    issues, stats = run_checks(cfg, entries, deep=args.archives)

    errors = [i for i in issues if i.level == "error"]
    warns = [i for i in issues if i.level == "warn"]

    if args.json:
        print(json.dumps({
            "ok": not errors,
            "issues": [asdict(i) for i in issues],
            "packs": [asdict(s) for s in stats],
            "totals": {
                "entries": len(entries),
                "packs": len(stats),
                "errors": len(errors),
                "warnings": len(warns),
            },
        }, indent=2))
        return EXIT_DRIFT if errors else EXIT_OK

    if errors:
        print(f"\n{len(errors)} error(s):")
        print_issues(errors)
    if warns:
        print(f"\n{len(warns)} warning(s):")
        print_issues(warns)
    if args.stats:
        print(f"\npacks:")
        print_stats(stats)
    if not errors and not warns:
        print(f"clean: {len(entries)} entries across {len(stats)} packs")
    elif not errors:
        print(f"\nno errors ({len(entries)} entries, {len(stats)} packs)")
    return EXIT_DRIFT if errors else EXIT_OK


def cmd_stats(args) -> int:
    """A presentation of the same computation check runs. Always exits 0."""
    cfg = load_config()
    entries = load_manifest(cfg)
    issues, stats = run_checks(cfg, entries)
    print_stats(stats)
    in_use = sum(1 for s in stats if s.assets)
    unused = [s.name for s in stats if s.assets == 0 and not s.keep]
    print(f"\n{len(entries)} assets from {in_use} of {len(stats)} packs")
    if unused:
        print(f"unused: {', '.join(unused)}")
    errs = sum(1 for i in issues if i.level == "error")
    if errs:
        print(f"\n{errs} error(s) — run 'kudo check' for detail")
    return EXIT_OK


def _find(entries: list[Entry], dest: str, cfg: Config) -> Entry:
    norm = rel_to_root(cfg, Path(dest))
    for e in entries:
        if e.dest in (dest, norm):
            return e
    raise KudoError(f"{dest} is not in the manifest")


def _find_all(entries: list[Entry], dests: list[str], cfg: Config) -> list[Entry]:
    return list({e.dest: e for e in (_find(entries, d, cfg) for d in dests)}.values())


def cmd_note(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    found = _find_all(entries, args.dest, cfg)
    for entry in found:
        entry.note = args.text
    rewrite_manifest(cfg, entries)
    for entry in found:
        print(f"{entry.dest}: {args.text or '(no note)'}")
    return EXIT_OK


def cmd_rm(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    found = _find_all(entries, args.dest, cfg)
    for entry in found:
        entries.remove(entry)
    rewrite_manifest(cfg, entries)
    for entry in found:
        target = cfg.root / entry.dest
        if args.delete and (target.is_file() or target.is_symlink()):
            target.unlink()
            print(f"removed {entry.dest} and deleted the file")
        else:
            print(f"removed {entry.dest}")
    for name in sorted({e.pack for e in found}):
        if not any(e.pack == name for e in entries):
            print(f"{cfg.vendor}/{name} now has no assets in use; "
                  f"delete it or set keep = true in its {SOURCE_NAME}")
    return EXIT_OK


def cmd_mv(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    entry = _find(entries, args.old, cfg)
    old = entry.dest

    target = args.new
    if Path(target).is_dir():
        target = os.path.join(target, Path(old).name)
    new = new_dest(cfg, target, {e.dest for e in entries})

    src = cfg.root / old
    dst = cfg.root / new
    moved = src.is_file() or src.is_symlink()
    if moved:
        if dst.exists() or dst.is_symlink():
            raise KudoError(f"{new} already exists")
        dst.parent.mkdir(parents=True, exist_ok=True)
        src.rename(dst)
    elif not dst.is_file():
        raise KudoError(f"neither {old} nor {new} exists")

    entry.dest = new
    rewrite_manifest(cfg, entries)
    warn_outside_roots(cfg, new)
    print(f"{'moved' if moved else 'followed'} {old}  ->  {new}")
    return EXIT_OK



def cmd_fetch(args) -> int:
    cfg = load_config()
    packs = all_packs(cfg)
    if args.packs:
        by_name = {p.name: p for p in packs}
        unknown = [n for n in args.packs if n not in by_name]
        if unknown:
            raise KudoError(f"no such vendor pack(s): {', '.join(unknown)}")
        packs = [by_name[n] for n in args.packs]

    fetched: list[Pack] = []
    manual: list[Pack] = []
    problems = 0

    for pack in packs:
        arc, arc_hash = archive_for(cfg, pack)
        url = pack.meta.get("archive_url")

        if arc is not None and arc.is_file() and not args.force:
            continue  # already have it

        if not url:
            manual.append(pack)
            continue

        name = str(pack.meta.get("archive") or Path(urllib.parse.urlparse(url).path).name)
        if not name:
            print(f"error: {pack.name}: cannot derive a filename from {url}",
                  file=sys.stderr)
            problems += 1
            continue
        target = cfg.archive_dir / name

        print(f"fetching {pack.name} <- {url}")
        try:
            size = download(str(url), target, timeout=args.timeout)
        except KudoError as exc:
            print(f"error: {pack.name}: {exc}", file=sys.stderr)
            problems += 1
            continue

        actual = hash_file(target)
        if arc_hash and actual != arc_hash:
            target.unlink()
            print(f"error: {pack.name}: downloaded file does not match the hash in "
                  f"{SOURCE_NAME}; discarded", file=sys.stderr)
            problems += 1
            continue
        if not arc_hash:
            print(f"  warning: no archive_hash recorded; nothing verified this "
                  f"download. Add archive_hash = {toml_str(actual)}")
        print(f"  {human_bytes(size)} -> {cfg.archive}/{name}")
        fetched.append(pack)

    for pack in manual:
        page = pack.meta.get("url", "(no url recorded)")
        print(f"{pack.name}: no archive_url. Download it from {page} and put the "
              f"zip in {cfg.archive}/", file=sys.stderr)

    if args.restore:
        for pack in fetched:
            print()
            cmd_restore(argparse.Namespace(pack=pack.name, force=False, dry_run=False))

    if not fetched and not manual and not problems:
        print("nothing to fetch; every archive is already present")
    return EXIT_DRIFT if problems else EXIT_OK


def cmd_restore(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    pack = load_pack(cfg, args.pack)
    if pack is None:
        raise KudoError(f"no such vendor pack: {args.pack}")

    arc, arc_hash = archive_for(cfg, pack)
    if arc is None:
        raise KudoError(
            f"{args.pack} has no 'archive' in its {SOURCE_NAME}; there is "
            "nothing to restore from. Re-download and 'kudo import' it."
        )
    if not arc.is_file():
        raise KudoError(f"archived zip is missing: {rel_to_root(cfg, arc)}")
    if arc_hash:
        actual = hash_file(arc)
        if actual != arc_hash and not args.force:
            raise KudoError(
                f"{rel_to_root(cfg, arc)} does not match the hash recorded at "
                "import. Restoring from it would replace your pristine copy "
                "with unknown content. Pass --force if you trust this zip."
            )

    if args.dry_run:
        used = sum(1 for e in entries if e.pack == args.pack)
        print(f"would re-extract {rel_to_root(cfg, arc)} over "
              f"{cfg.vendor}/{args.pack}/ ({used} assets come from it)")
        return EXIT_OK

    # SOURCE.toml is ours, not the zip's. Everything else is replaced.
    source_toml = (pack.dir / SOURCE_NAME).read_bytes() if (pack.dir / SOURCE_NAME).is_file() else None
    shutil.rmtree(pack.dir)
    pack.dir.mkdir(parents=True)
    extract_pack(arc, pack.dir)
    if source_toml is not None:
        (pack.dir / SOURCE_NAME).write_bytes(source_toml)

    print(f"restored {cfg.vendor}/{args.pack}/ from {rel_to_root(cfg, arc)}")
    return EXIT_OK


def distinct_notes(used: list[Entry]) -> list[str]:
    return list(dict.fromkeys(e.note for e in used if e.note))


def render_markdown(cfg: Config, groups: list[tuple[Pack, list[Entry]]]) -> str:
    out = ["# Credits", ""]
    out.append("Third-party assets used in this project, with thanks.")
    out.append("")
    for pack, used in groups:
        m = pack.meta
        out.append(f"## {m.get('name', pack.name)}")
        out.append("")
        out.append(pack.credit_line())
        bits = []
        if m.get("url"):
            bits.append(f"Source: <{m['url']}>")
        if m.get("license"):
            bits.append(f"License: {m['license']}")
        if bits:
            out.append("")
            out.append("  \n".join(bits))
        notes = distinct_notes(used)
        if notes:
            out.append("")
            out.append("Modified for this project:")
            out.append("")
            for note in notes:
                out.append(f"- {note}")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def render_text(cfg: Config, groups: list[tuple[Pack, list[Entry]]]) -> str:
    out = ["CREDITS", ""]
    for pack, used in groups:
        m = pack.meta
        line = pack.credit_line()
        if m.get("license"):
            line += f" ({m['license']})"
        out.append(line)
        if m.get("url"):
            out.append(f"  {m['url']}")
        for note in distinct_notes(used):
            out.append(f"  modified: {note}")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def render_json(cfg: Config, groups: list[tuple[Pack, list[Entry]]]) -> str:
    payload = []
    for pack, used in groups:
        m = pack.meta
        payload.append({
            "pack": pack.name,
            "title": m.get("name", pack.name),
            "author": m.get("author"),
            "url": m.get("url"),
            "license": m.get("license"),
            "attribution": pack.credit_line(),
            "notes": distinct_notes(used),
            "files": [
                {"path": e.dest, "note": e.note or None}
                for e in used
            ],
        })
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def cmd_credits(args) -> int:
    cfg = load_config()
    entries = load_manifest(cfg)
    if not args.force:
        issues, _ = run_checks(cfg, entries)
        errors = [i for i in issues if i.level == "error"]
        if errors:
            print(f"refusing to generate credits: {len(errors)} error(s) from "
                  "'kudo check'. Credits built on a broken manifest are worse "
                  "than no credits. Pass --force to override.", file=sys.stderr)
            return EXIT_DRIFT

    by_pack: dict[str, list[Entry]] = {}
    for e in entries:
        by_pack.setdefault(e.pack, []).append(e)

    groups: list[tuple[Pack, list[Entry]]] = []
    for name in sorted(by_pack):
        pack = load_pack(cfg, name)
        if pack is None:
            print(f"warning: skipping missing pack '{name}'", file=sys.stderr)
            continue
        groups.append((pack, by_pack[name]))

    render = {"md": render_markdown, "txt": render_text, "json": render_json}[args.format]
    text = render(cfg, groups)

    if args.output == "-":
        sys.stdout.write(text)
    else:
        out = cfg.root / (args.output or cfg.credits_output)
        out.write_text(text, encoding="utf-8")
        print(f"wrote {rel_to_root(cfg, out)}  ({len(groups)} packs, {len(entries)} files)")
    return EXIT_OK


def cmd_help(parser: argparse.ArgumentParser, commands: dict, args) -> int:
    if args.topic is None:
        parser.print_help()
    elif args.topic in commands:
        commands[args.topic].print_help()
    else:
        raise KudoError(f"no such command: {args.topic}\n"
                        f"commands: {', '.join(commands)}")
    return EXIT_OK


