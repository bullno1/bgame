def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="kudo",
        description="Track attribution for third-party game assets.",
        epilog="Exit codes: 0 clean, 1 drift detected, 2 usage error.",
    )
    p.add_argument("--version", action="version", version=f"kudo {VERSION}")
    sub = p.add_subparsers(dest="command", required=True, metavar="<command>")

    s = sub.add_parser("init", help="create kudo.toml and the directory layout")
    s.set_defaults(func=cmd_init)

    s = sub.add_parser("import", help="unpack a zip or folder into vendor/ and scaffold SOURCE.toml")
    s.add_argument("path", help="zip file or directory to import")
    s.add_argument("name", nargs="?", help="vendor pack name (default: filename stem)")
    s.add_argument("--title")
    s.add_argument("--author")
    s.add_argument("--url")
    s.add_argument("--license", help="SPDX identifier, e.g. CC-BY-4.0")
    s.add_argument("--pack-version", metavar="VERSION")
    s.add_argument("--archive-url", help="direct download URL for the zip, so "
                   "'kudo fetch' can re-acquire it")
    s.add_argument("--no-archive", action="store_true", help="do not keep the original zip")
    s.set_defaults(func=cmd_import)

    s = sub.add_parser("add", help="record a vendor file as used, and materialize it")
    s.add_argument("source", help="path inside vendor/, e.g. kenney_pack/tiles/block.png")
    s.add_argument("dest", help="where it lands, e.g. assets/sprites/block.png")
    s.add_argument("--modified", action="store_true",
                   help="you supplied a derived version at dest; kudo will not overwrite it")
    s.add_argument("--note", help="what you changed (required in spirit by CC BY)")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("sync", help="make the working tree match the manifest")
    s.set_defaults(func=cmd_sync)

    s = sub.add_parser("check", help="verify the tree against the manifest")
    s.add_argument("--fix", action="store_true", help="repair the mechanical failures")
    s.add_argument("--json", action="store_true")
    s.add_argument("--stats", action="store_true", help="also print per-pack usage")
    s.add_argument("--archives", action="store_true",
                   help="also hash the archived zips (slow on large packs)")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("stats", help="per-pack usage report (always exits 0)")
    s.set_defaults(func=cmd_stats)

    s = sub.add_parser("bless", help="accept the current state of a modified asset")
    s.add_argument("dest")
    s.add_argument("--upstream", action="store_true",
                   help="also accept the current vendor file as its basis")
    s.add_argument("--note")
    s.set_defaults(func=cmd_bless)

    s = sub.add_parser("edit", help="mark an asset modified and unlock it for editing")
    s.add_argument("dest")
    s.add_argument("--note")
    s.set_defaults(func=cmd_edit)

    s = sub.add_parser("rm", help="drop an entry and its destination")
    s.add_argument("dest")
    s.add_argument("--force", action="store_true", help="allow removing a modified asset")
    s.add_argument("--keep-file", action="store_true", help="leave the file on disk")
    s.set_defaults(func=cmd_rm)

    s = sub.add_parser("fetch", help="download missing archives from archive_url")
    s.add_argument("packs", nargs="*", help="pack names (default: all with a missing archive)")
    s.add_argument("--restore", action="store_true",
                   help="also re-extract vendor content and sync destinations")
    s.add_argument("--force", action="store_true", help="re-download even if present")
    s.add_argument("--timeout", type=int, default=120)
    s.set_defaults(func=cmd_fetch)

    s = sub.add_parser("restore", help="rebuild a vendor pack from its archived zip")
    s.add_argument("pack", help="vendor pack name")
    s.add_argument("--force", action="store_true",
                   help="restore even if the archive hash does not match")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--no-sync", action="store_true",
                   help="do not re-materialize destinations afterwards")
    s.set_defaults(func=cmd_restore)

    s = sub.add_parser("credits", help="generate the attribution list")
    s.add_argument("--format", choices=["md", "txt", "json"], default="md")
    s.add_argument("-o", "--output", help="path, or - for stdout")
    s.add_argument("--force", action="store_true", help="generate even if check fails")
    s.set_defaults(func=cmd_credits)

    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except KudoError as exc:
        print(f"kudo: {exc}", file=sys.stderr)
        return EXIT_USAGE
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
